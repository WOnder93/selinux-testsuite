; class anon_inode declared in test_userfaultfd.cil

(typeattributeset cil_gen_require test_secretmem_inode_t)

; Allow creating secret memory
(typeattributeset cil_gen_require test_create_secretmem_t)
(allow test_create_secretmem_t self (anon_inode (create)))

; Declare type transition without any permissions
(typeattributeset cil_gen_require test_nocreate_transition_secretmem_t)
(typetransition test_nocreate_transition_secretmem_t test_nocreate_transition_secretmem_t anon_inode "[secretmem]" test_secretmem_inode_t)

; Allow creating secret memory with a type transition
(typeattributeset cil_gen_require test_create_transition_secretmem_t)
(typetransition test_create_transition_secretmem_t test_create_transition_secretmem_t anon_inode "[secretmem]" test_secretmem_inode_t)
(allow test_create_transition_secretmem_t test_secretmem_inode_t (anon_inode (create)))
